{
  "expo": {
    "name": "Sai Constructions",
    "slug": "sai-constructions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saiconstructions.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saiconstructions.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sai Constructions uses your photos to attach bills, payment proofs and site progress.",
          "cameraPermission": "Sai Constructions uses the camera to photograph bills and site progress.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sai Constructions records where site progress photos were taken."
        }
      ],
      "expo-font"
    ],
    "scheme": "saiconstructions",
    "experiments": {
      "typedRoutes": true
    }
  }
}
