DATABASE_URL=postgresql+psycopg://sai:sai@localhost:5432/sai
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-0000
SMS_PROVIDER=console
# Shows the OTP in the API response for testing. MUST be false in production.
DEV_EXPOSE_OTP=true
APP_BASE_URL=http://localhost:8081
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Storage: local (disk) or vercel_blob
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
API_BASE_URL=http://localhost:8000
# Serverless (Vercel + Neon pooled URL): true
DB_NULL_POOL=false
# One-time browser setup endpoint; leave empty to disable
BOOTSTRAP_TOKEN=
